@@ -1965,6 +1976,21 @@
 
 
 
+%% DOI
+
+FUNCTION {format.doi}
+{ doi empty$
+    { "" }
+    { this.to.prev.status
+      this.status.std
+      % the IEEE Reference Guide puts a comma before the DOI, also after a note
+      punct.comma 'prev.status.punct :=
+      "doi: \BIBdoi{" doi * "}" *
+    }
+  if$
+}
+
